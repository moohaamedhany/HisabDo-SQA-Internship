{
  "info": {
    "name": "Day 6 - Authentication API Test Suite (SQA Internship - Mohamed Hany)",
    "description": "Auth API tests for DummyJSON (dummyjson.com/auth, /users) covering registration(simulated), login, logout behavior, invalid login, duplicate registration, missing fields, invalid email, password validation, and unauthorized access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dummyjson.com"
    },
    {
      "key": "validAccessToken",
      "value": "PASTE_TOKEN_FROM_TC_006_HERE"
    }
  ],
  "item": [
    {
      "name": "Registration (simulated via /users/add)",
      "item": [
        {
          "name": "TC_001 - Register (simulated) with valid data",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/add",
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"Mo\", \"lastName\": \"Hany\", \"username\": \"mohanytest\", \"email\": \"mohanytest@mail.com\", \"password\": \"Test@1234\"}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has new id', function () { pm.expect(pm.response.json()).to.have.property('id'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
